# ==========================================
#  منصّة فرح — .gitignore (Monorepo)
# ==========================================

# ---------- أسرار وبيئة ----------
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
secrets/
config/local.*
google-services.json
GoogleService-Info.plist

# ---------- Flutter / Dart ----------
.dart_tool/
.packages
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.iml
*.ipr
*.iws
.metadata
mobile/android/local.properties
mobile/android/.gradle/
mobile/android/app/release/
mobile/android/key.properties
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh

# ---------- Backend: PHP / Laravel ----------
vendor/
storage/*.key
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*
composer.phar
.phpunit.result.cache

# ---------- Backend: Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
.next/

# ---------- Backend: Python ----------
__pycache__/
*.py[cod]
venv/
.venv/
env/

# ---------- قواعد البيانات والرفوعات ----------
*.sqlite
*.sqlite3
*.db
database/*.sql.gz
uploads/
storage/app/public/proofs/

# ---------- السجلات ----------
*.log
logs/

# ---------- محررات وبيئات تطوير ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*.sublime-workspace

# ---------- أنظمة التشغيل ----------
.DS_Store
._*
Thumbs.db
desktop.ini

# ---------- التصميم ----------
# ارفعوا الأصول المصدَّرة (SVG/PNG) لا ملفات العمل الضخمة
*.fig
*.sketch
*.xd
*.psd
*.ai
design/exports/temp/

# ---------- ملفات مؤقتة ----------
tmp/
temp/
*.tmp
*.bak
*.cache
coverage/
.nyc_output/
